# 忆码 YiCode 环境变量配置
# 复制本文件为 .env 并修改对应值

# 数据库（默认使用 data/yicode.db 文件，重启不丢数据）
# DATABASE_URL=sqlite:///./data/yicode.db

# 安全密钥（生产环境必须修改）
# SECRET_KEY=your-secret-key-here

# 飞书 Bot 配置（Phase 2 启用）
# FEISHU_WEBHOOK=https://open.feishu.cn/...
# FEISHU_SECRET=your-secret

# LLM 配置（AI Tutor 真实大模型，默认 mock 基于规则、无需 key）
# LLM_PROVIDER=kimi            # mock | kimi | openai（openai 兼容任何 OpenAI 格式服务）
# LLM_API_KEY=sk-...
# LLM_BASE_URL=                # 可选，kimi 默认 https://api.moonshot.cn/v1
# LLM_MODEL=                   # 可选，kimi 默认 moonshot-v1-8k
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_TOKENS=2048
# LLM_TEMPERATURE=0.7
